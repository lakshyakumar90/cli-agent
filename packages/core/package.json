{
  "name": "@cli-agent/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "demo:loop": "tsx scripts/demo-loop.ts",
    "demo:consumers": "tsx scripts/demo-consumers.ts",
    "demo:tools": "tsx scripts/demo-tools.ts",
    "demo:permissions": "tsx scripts/demo-permissions.ts",
    "demo:prompt": "tsx scripts/demo-prompt.ts",
    "demo:compact": "tsx scripts/demo-compact.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cli-agent/ai": "workspace:*",
    "@cli-agent/tools": "workspace:*",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.0",
    "zod": "^4.6.7"
  }
}

