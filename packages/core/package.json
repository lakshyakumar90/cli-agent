{
  "name": "@cli-agent/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "demo:loop": "tsx scripts/demo-loop.ts",
    "demo:consumers": "tsx scripts/demo-consumers.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cli-agent/ai": "workspace:*",
    "@cli-agent/tools": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  }
}
