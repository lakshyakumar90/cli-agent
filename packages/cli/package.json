{
  "name": "@cli-agent/cli",
  "version": "0.1.0",
  "description": "A coding agent in the terminal: it reads a codebase, changes it, runs the tests and explains what it did.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakshyakumar90/cli-agent.git"
  },
  "bugs": {
    "url": "https://github.com/lakshyakumar90/cli-agent/issues"
  },
  "homepage": "https://github.com/lakshyakumar90/cli-agent#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "build:binary": "bun build --compile src/cli.ts --outfile agent",
    "demo:extensions": "tsx scripts/demo-extensions.ts",
    "start": "node dist/cli.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@cli-agent/ai": "workspace:*",
    "@cli-agent/core": "workspace:*",
    "@cli-agent/tools": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  }
}
