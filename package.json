{
  "name": "cli-agent",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@cli-agent/cli",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" }
}
