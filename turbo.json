{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GEMINI_API_KEY",
    "OPENCODE_API_KEY",
    "OPENROUTER_API_KEY",
    "CODEX_ACCESS_TOKEN",
    "CODEX_ACCOUNT_ID",
    "ANTIGRAVITY_ACCESS_TOKEN",
    "MYAGENT_HOME",
    "MYAGENT_CODEX_CLIENT_ID",
    "MYAGENT_GOOGLE_CLIENT_ID",
    "MYAGENT_GOOGLE_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "check-types": { "dependsOn": ["^check-types"] },
    "test": { "outputs": [] }
  }
}
